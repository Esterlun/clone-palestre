# URL del database usato da Prisma. In sviluppo locale si usa SQLite; per passare
# a PostgreSQL in un altro ambiente basta cambiare questo valore e il campo
# "provider" del datasource in prisma/schema.prisma (nessuna query raw da riscrivere).
#
# Nota: per il datasource SQLite, Prisma risolve il percorso "file:..." come
# relativo alla cartella di schema.prisma (prisma/), non alla directory da
# cui viene lanciato il comando. "file:./dev.db" produce quindi
# prisma/dev.db, non prisma/prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Segreto usato per firmare i token di sessione (JWT). Deve essere una stringa
# lunga e casuale, diversa per ogni ambiente. Non committare mai il valore reale.
# Generane uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="cambia-questo-valore-con-una-stringa-casuale-lunga"
